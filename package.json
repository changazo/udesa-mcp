{
  "name": "udesa-campus-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP no oficial para el Campus Virtual (Moodle) de UdeSA: lecturas y escrituras, local (STDIO) o remoto privado (Vercel).",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "campus": "build/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
